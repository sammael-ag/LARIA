{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Laria-CrystalCore",
  "version": "0.1.0",
  "identifier": "laria-crystal-core",
  "build": {
    "beforeDevCommand": "BROWSER=none npx expo start --web",
    "devUrl": "http://localhost:8081",
    "beforeBuildCommand": "",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "LARIA",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "shell": {
      "open": "^(data:text/html;|mailto:|tel:|https?://).+"
    }
  }
}